{
  "name": "agent-events",
  "version": "0.1.0",
  "description": "Validate agent-events run files (JSON Lines) against the core and profile schemas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GravionLabs/agent-events.git"
  },
  "type": "module",
  "bin": {
    "agent-events": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/validate.ts test/state.ts test/binding.ts test/profile.ts test/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
